TOOL_TIMEOUT_S=8
TURN_DEADLINE_S=25
LEASE_SECONDS=30
LEASE_WAIT_S=8
LLM_CONCURRENCY=4
RATE_SESSION_PER_MIN=10
RATE_IP_PER_HOUR=30
