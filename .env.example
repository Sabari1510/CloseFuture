# --- LLM / embeddings ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL_SMALL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
EMBED_API_KEY=

# --- Database (Supabase, Session pooler URI, port 5432) ---
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
LLM_MODE=fake

# --- Google Calendar (owner OAuth, Gmail API for lead mail) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
CALENDAR_TZ=Asia/Kolkata
BUSINESS_HOURS=Mon-Fri 10-17
SLOT_MINUTES=30
LOOKAHEAD_DAYS=14
MIN_NOTICE_HOURS=4

# --- Email (Gmail API per user choice) ---
EMAIL_PROVIDER=gmail
EMAIL_FROM=
SALES_INBOX=

# --- App ---
COMPANY_NAME=CloseFuture
ADMIN_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000
